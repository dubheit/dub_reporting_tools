<?xml version="1.0" encoding="UTF-8"?>
<report xmlns="http://www.eclipse.org/birt/2005/design" version="3.2.24" id="1">
    <property name="author">Dubhe</property>
    <property name="createdBy">dub_reporting_birt_demo</property>
    <text-property name="title">Sales by Customer</text-property>
    <property name="units">mm</property>
    <property name="layoutPreference">auto layout</property>

    <!-- Formats of the user language: Odoo sends the separators and the
         date pattern as report parameters, so the output does not depend on
         the locale of the BIRT server. -->
    <method name="initialize"><![CDATA[
function odooAmount(value) {
    var symbols = java.text.DecimalFormatSymbols.getInstance(java.util.Locale.ROOT);
    var text = String(new java.text.DecimalFormat("#,##0.00", symbols).format(value == null ? 0 : value));
    var decimal = params["decimal_point"].value || ".";
    var thousands = params["thousands_sep"].value == null ? "," : params["thousands_sep"].value;
    return text.replace(/,/g, "\u0001").replace(/\./g, decimal).replace(/\u0001/g, thousands);
}
function odooDate(value) {
    if (value == null) {
        return "";
    }
    var pattern = params["date_pattern"].value || "yyyy-MM-dd";
    return String(new java.text.SimpleDateFormat(pattern).format(new java.util.Date(value.getTime())));
}
]]></method>

    <!-- Runtime DB connection. Priority: db_* report parameters (sent by
         Odoo) then JVM system properties (-DDB_HOST etc. set by the
         container entrypoint). MUST be at root level: ignored if placed
         inside the data source. id=200 references OdooDB. -->
    <list-property name="propertyBindings">
        <structure>
            <property name="name">odaURL</property>
            <property name="id">200</property>
            <expression name="value" type="javascript">params["db_host"].value ? "jdbc:postgresql://" + params["db_host"].value + ":" + (params["db_port"].value ? params["db_port"].value : "5432") + "/" + params["db_name"].value : "jdbc:postgresql://" + java.lang.System.getProperty("DB_HOST") + ":" + java.lang.System.getProperty("DB_PORT") + "/" + java.lang.System.getProperty("DB_NAME")</expression>
        </structure>
        <structure>
            <property name="name">odaUser</property>
            <property name="id">200</property>
            <expression name="value" type="javascript">params["db_user"].value ? params["db_user"].value : java.lang.System.getProperty("DB_USER")</expression>
        </structure>
        <structure>
            <property name="name">odaPassword</property>
            <property name="id">200</property>
            <expression name="value" type="javascript">params["db_password"].value ? params["db_password"].value : java.lang.System.getProperty("DB_PASSWORD")</expression>
        </structure>
    </list-property>

