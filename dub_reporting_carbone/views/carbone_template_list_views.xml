<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="carbone_template_list_view_tree" model="ir.ui.view">
        <field name="name">carbone.template.list.list</field>
        <field name="model">carbone.template.list</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <header>
                    <button name="action_refresh_list"
                        type="object"
                        string="Refresh"
                        class="btn-secondary"
                        icon="fa-refresh"/>
                    <button name="action_delete_orphan_templates"
                        type="object"
                        string="Delete Orphans"
                        class="btn-warning"
                        icon="fa-trash"
                        confirm="Delete all templates not linked to any Odoo report?"/>
                </header>
                <field name="name"/>
                <field name="template_id" string="Version ID" optional="hide"/>
                <field name="constant_id" string="Template ID" optional="hide"/>
                <field name="extension"/>
                <field name="size" widget="integer"/>
                <field name="created_at"/>
                <field name="deployed_at" optional="hide"/>
                <field name="expire_at" optional="hide"/>
                <field name="category"/>
                <field name="comment" optional="hide"/>
                <field name="tags"/>
                <field name="origin"/>
                <field name="linked_report_id"/>
                <button name="action_delete_template"
                    type="object"
                    string="Delete"
                    class="btn-link text-danger"
                    icon="fa-trash"
                    confirm="Delete this template from Carbone server?"
                    invisible="linked_report_id"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_carbone_template_list" model="ir.actions.act_window">
        <field name="name">Carbone Server Templates</field>
        <field name="res_model">carbone.template.list</field>
        <field name="view_mode">list</field>
        <field name="target">current</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
