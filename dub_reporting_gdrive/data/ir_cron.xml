<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cron job to renew expiring Google Drive webhook channels -->
    <record id="ir_cron_gdrive_renew_channels" model="ir.cron">
        <field name="name">Google Drive: Renew Webhook Channels</field>
        <field name="model_id" ref="model_gdrive_sync_channel"/>
        <field name="state">code</field>
        <field name="code">model._cron_renew_channels()</field>
        <field name="interval_number">12</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>

    <!-- Cron job to cleanup expired channels -->
    <record id="ir_cron_gdrive_cleanup_channels" model="ir.cron">
        <field name="name">Google Drive: Cleanup Expired Channels</field>
        <field name="model_id" ref="model_gdrive_sync_channel"/>
        <field name="state">code</field>
        <field name="code">model._cleanup_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

</odoo>
