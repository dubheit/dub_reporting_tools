<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Server action to open ILovePDF wizard on documents -->
        <record id="ir_actions_server_ilovepdf_process" model="ir.actions.server">
            <field name="name">Process with ILovePDF</field>
            <field name="sequence">80</field>
            <field name="model_id" ref="documents.model_documents_document"/>
            <field name="groups_id" eval="[Command.link(ref('documents.group_documents_user'))]"/>
            <field name="usage">ir_actions_server</field>
            <field name="state">code</field>
            <field name="code">
action = {
    'name': 'Process with ILovePDF',
    'type': 'ir.actions.act_window',
    'res_model': 'ilovepdf.documents.wizard',
    'view_mode': 'form',
    'views': [[False, 'form']],
    'target': 'new',
    'context': {
        'default_document_ids': records.ids,
        'active_model': 'documents.document',
        'active_ids': records.ids,
    },
}
            </field>
        </record>

    </data>
</odoo>
