<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cron job to renew expiring SharePoint webhook subscriptions -->
    <record id="ir_cron_sharepoint_renew_subscriptions" model="ir.cron">
        <field name="name">SharePoint: Renew Webhook Subscriptions</field>
        <field name="model_id" ref="model_sharepoint_subscription"/>
        <field name="state">code</field>
        <field name="code">model._cron_renew_subscriptions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <!-- Cron job to cleanup expired subscriptions -->
    <record id="ir_cron_sharepoint_cleanup_subscriptions" model="ir.cron">
        <field name="name">SharePoint: Cleanup Expired Subscriptions</field>
        <field name="model_id" ref="model_sharepoint_subscription"/>
        <field name="state">code</field>
        <field name="code">model._cleanup_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

</odoo>
