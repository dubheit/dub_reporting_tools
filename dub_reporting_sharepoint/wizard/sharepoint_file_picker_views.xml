<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view for files with Select button -->
    <record id="sharepoint_file_picker_line_view_list" model="ir.ui.view">
        <field name="name">sharepoint.file.picker.line.list</field>
        <field name="model">sharepoint.file.picker.line</field>
        <field name="arch" type="xml">
            <list string="Files" create="false" delete="false" edit="false">
                <field name="name" string="File Name"/>
                <field name="file_type" string="Type" width="100px"/>
                <field name="modified_time" string="Modified" width="150px"/>
                <button name="action_select_this"
                        string="Select"
                        type="object"
                        icon="fa-check"
                        class="btn-primary btn-sm"/>
                <field name="item_id" column_invisible="1"/>
                <field name="mime_type" column_invisible="1"/>
                <field name="picker_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Main file picker wizard -->
    <record id="sharepoint_file_picker_view_form" model="ir.ui.view">
        <field name="name">sharepoint.file.picker.form</field>
        <field name="model">sharepoint.file.picker</field>
        <field name="arch" type="xml">
            <form string="Select SharePoint File">
                <field name="report_id" invisible="1"/>
                <field name="next_link" invisible="1"/>
                <field name="has_more" invisible="1"/>

                <group>
                    <group>
                        <div class="d-flex gap-2 align-items-end">
                            <field name="search_query"
                                   placeholder="Search files by name..."
                                   class="flex-grow-1"/>
                            <button name="action_search"
                                    string="Search"
                                    type="object"
                                    icon="fa-search"
                                    class="btn-primary"/>
                            <button name="action_refresh"
                                    string="Refresh"
                                    type="object"
                                    icon="fa-refresh"
                                    class="btn-secondary"/>
                        </div>
                    </group>
                </group>

                <field name="file_ids" nolabel="1" mode="list"/>

                <footer>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sharepoint_file_picker" model="ir.actions.act_window">
        <field name="name">Select SharePoint File</field>
        <field name="res_model">sharepoint.file.picker</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="sharepoint_file_picker_view_form"/>
    </record>

</odoo>
